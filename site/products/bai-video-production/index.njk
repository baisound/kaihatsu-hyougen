    <section class="bvp2-section bvp2-faq" id="faq" data-section>
      <div class="bvp2-shell">
        <div class="bvp2-heading reveal"><p class="connection-label cyan"><i></i>07 / FAQ</p><h2>よくある質問</h2></div>
