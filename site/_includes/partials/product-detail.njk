{% set seo = productSeo[productSlug] %}
{% set metaTitle = seo.title %}
{% set metaDescription = seo.description %}
{% set canonicalPath = "/products/" + productSlug + "/" %}
{% set metaCurrentTitle = product.title %}
{% set metaParentTitle = "プロダクト" %}
{% set metaParentPath = "/products/" %}
{% set metaRobots = seo.robots %}
{% set metaImage = seo.image %}
{% set metaImageAlt = seo.imageAlt %}
<!doctype html>
<html lang="ja">
<head>
  {% include "partials/analytics-head.njk" %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
{% include "partials/meta.njk" %}
  <link rel="stylesheet" href="../../css/styles.css">
  <link rel="stylesheet" href="../../css/subpages.css">
  <script src="../../scripts/script.js" defer></script>
</head>
<body>
  {% include "partials/analytics-body.njk" %}
  {% include "partials/header.njk" %}

  <main id="content" class="subpage-main product-detail2-page product-tone-{{ product.statusTone }}">
    <section class="product-detail2-hero" id="top" data-section>
      <div class="product-detail2-shell">
        <nav class="breadcrumbs" aria-label="パンくず"><a href="../../">HOME</a><b aria-hidden="true">/</b><a href="../">プロダクト</a><b aria-hidden="true">/</b><span>{{ product.title }}</span></nav>
        <div class="product-detail2-hero-grid">
          <div class="reveal">
            <p class="product-detail2-status"><span>{{ product.status }}</span><span>{{ product.platform }}</span></p>
            <h1>{{ product.shortTitle }}</h1>
            <p class="product-detail2-audience">{{ product.audience }}</p>
            <p class="product-detail2-promise"><b>{{ product.promise }}</b></p>
            <div class="product-detail2-actions"><a class="action action-dark" data-cta-id="product-{{ productSlug }}-changes" href="#changes"><span>変わることを見る</span><span aria-hidden="true">↓</span></a><a class="action action-light" data-cta-id="product-{{ productSlug }}-status" href="#status"><span>現在の状況</span><span aria-hidden="true">↓</span></a></div>
          </div>
          <div class="product-detail2-visual-stack">
            <figure class="product-detail2-visual reveal" style="--delay:80ms">
              <picture><source srcset="../..{{ seo.imageBase }}.avif" type="image/avif"><source srcset="../..{{ seo.imageBase }}.webp" type="image/webp"><img src="../..{{ seo.image }}" width="1672" height="941" alt="{{ seo.imageAlt }}" fetchpriority="high"></picture>
              <figcaption><b>CONCEPT VISUAL</b><span>製品の用途を示す構成イメージです。実際の製品画面や利用環境ではありません。</span></figcaption>
            </figure>
            <figure class="product-detail2-flow reveal" style="--delay:140ms">
              <figcaption><span>PRODUCT FLOW</span><b>現在の設計・実装範囲を、機能の流れで示しています。</b></figcaption>
              <ol>
                {% for step in product.flow %}
                <li><span>0{{ loop.index }}</span><b>{{ step }}</b></li>
                {% endfor %}
              </ol>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <nav class="product-detail2-nav reveal" aria-label="ページ内メニュー">
      <div class="product-detail2-shell"><a href="#problems">困りごと</a><a href="#changes">変わること</a><a href="#workflow">使い方の流れ</a><a href="#status">現在の状況</a><a href="#boundaries">大切にすること</a><a href="#faq">FAQ</a></div>
    </nav>

    <section class="product-detail2-section" id="problems" data-section>
      <div class="product-detail2-shell">
        <div class="product-detail2-heading reveal"><p class="connection-label cyan"><i></i>PROBLEMS</p><h2>どんな作業に使うか</h2></div>
        <div class="product-detail2-card-grid">
          {% for item in product.problems %}
          <article class="product-detail2-card reveal" style="--delay:{{ loop.index0 * 60 }}ms"><span>0{{ loop.index }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p></article>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="product-detail2-section product-detail2-changes" id="changes" data-section>
      <div class="product-detail2-shell">
        <div class="product-detail2-heading reveal"><p class="connection-label orange"><i></i>WHAT CHANGES</p><h2>主な機能</h2></div>
        <div class="product-detail2-change-grid">
          {% for item in product.changes %}
          <article class="reveal" style="--delay:{{ loop.index0 * 60 }}ms"><div>{{ item.mark }}</div><h3>{{ item.title }}</h3><p>{{ item.text }}</p></article>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="product-detail2-section" id="workflow" data-section>
      <div class="product-detail2-shell">
        <div class="product-detail2-heading reveal"><p class="connection-label violet"><i></i>WORKFLOW</p><h2>使い方</h2></div>
        <ol class="product-detail2-steps">
          {% for item in product.workflow %}
          <li class="reveal" style="--delay:{{ loop.index0 * 50 }}ms"><span>0{{ loop.index }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p></li>
          {% endfor %}
        </ol>
      </div>
    </section>

    <section class="product-detail2-section product-detail2-status-section" id="status" data-section>
      <div class="product-detail2-shell">
        <div class="product-detail2-heading reveal"><p class="connection-label orange"><i></i>CURRENT STATUS</p><h2>開発・提供状況</h2></div>
        <div class="product-detail2-status-grid">
          {% for item in product.current %}
          <article class="is-{{ item.tone }} reveal" style="--delay:{{ loop.index0 * 60 }}ms"><span>{{ item.label }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p></article>
          {% endfor %}
        </div>
        <details class="product-detail2-evidence reveal">
          <summary><span>開発記録</span><small>確認できていること</small></summary>
          <ul>{% for item in product.evidence %}<li>{{ item }}</li>{% endfor %}</ul>
        </details>
      </div>
    </section>

    <section class="product-detail2-section" id="boundaries" data-section>
      <div class="product-detail2-shell">
        <div class="product-detail2-heading reveal"><p class="connection-label violet"><i></i>BOUNDARIES</p><h2>利用上の注意</h2></div>
        <div class="product-detail2-boundary-grid">
          {% for item in product.boundaries %}
          <article class="reveal" style="--delay:{{ loop.index0 * 60 }}ms"><h3>{{ item.title }}</h3><p>{{ item.text }}</p></article>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="product-detail2-section product-detail2-faq" id="faq" data-section>
      <div class="product-detail2-shell">
        <div class="product-detail2-heading reveal"><p class="connection-label cyan"><i></i>FAQ</p><h2>よくある質問</h2></div>
        <div class="product-detail2-faq-list">
          {% for item in product.faq %}
          <details class="reveal"><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="product-detail2-final" data-section>
      <div class="product-detail2-shell reveal">
        <div><span>DISCUSS THE USE CASE</span><h2>このツールについて相談する</h2><p>現在の作り方や運用を伺い、支援できる範囲と、まだできないことを分けてお伝えします。</p></div>
        <div class="product-detail2-final-actions"><a class="action action-white" data-cta-id="product-{{ productSlug }}-contact" href="../../contact/#form"><span>相談内容とフォームを確認する</span><span aria-hidden="true">→</span></a><a href="../">プロダクト一覧へ戻る →</a></div>
      </div>
    </section>
  </main>

  {% include "partials/footer.njk" %}
</body>
</html>
