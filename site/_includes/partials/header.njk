<a class="skip-link" href="#content">本文へ移動</a>

<header class="site-header" data-header>
  <div class="header-colors" aria-hidden="true">
    <span class="color-cyan"></span><span class="color-violet"></span><span class="color-orange"></span>
  </div>
  <div class="header-inner">
    <a class="header-brand" href="{{ sectionPath }}#top" aria-label="開発と表現 トップへ">
      <img src="{{ rootPath }}images/assets/company-wordmark.png" width="2172" height="724" alt="開発と表現">
    </a>
    <nav class="desktop-nav" aria-label="主要ナビゲーション">{% for item in brandNav %}<a{% if pageKey in item.activePages %} aria-current="page" class="nav-current"{% endif %} href="{{ rootPath }}{{ item.path }}">{{ item.label }}</a>{% endfor %}</nav>
    <a{% if pageKey == "contact" %} aria-current="page"{% endif %} class="header-contact" data-cta-id="header-contact" href="{% if pageKey == "contact" %}#form{% else %}{{ rootPath }}contact/{% endif %}"><span>相談する</span><span aria-hidden="true">{% if pageKey == "contact" %}↓{% else %}↗{% endif %}</span></a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
      <span class="sr-only">メニューを開く</span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="モバイルナビゲーション" data-mobile-menu>{% for item in brandNav %}<a{% if pageKey in item.activePages %} aria-current="page" class="nav-current"{% endif %} href="{{ rootPath }}{{ item.path }}">{{ item.label }}</a>{% endfor %}
    <a{% if pageKey == "contact" %} aria-current="page"{% endif %} href="{% if pageKey == "contact" %}#form{% else %}{{ rootPath }}contact/{% endif %}">相談する</a>
  </nav>
</header>

<aside class="signal-rail" aria-hidden="true">
  <span class="signal-cyan"></span><span class="signal-violet" data-signal></span><span class="signal-orange"></span>
</aside>
