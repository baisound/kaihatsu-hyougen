{% if analytics.enabled %}
  <script>
  (() => {
    // Keep a refusal made in the previous version for its original validity period.
    try {
      const saved = JSON.parse(localStorage.getItem('kaihatsu_hyougen_analytics_consent_v1'));
      if (saved?.choice === 'denied' && Date.now() - saved.updatedAt <= 180 * 86400000) return;
    } catch { /* Storage can be unavailable. */ }

    window.siteAnalyticsEnabled = true;
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
    gtag('set', 'ads_data_redaction', true);
    window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
    const tag = document.createElement('script');
    tag.async = true;
    tag.src = 'https://www.googletagmanager.com/gtm.js?id={{ analytics.gtmContainerId }}';
    document.head.append(tag);
  })();
  </script>
{% endif %}
